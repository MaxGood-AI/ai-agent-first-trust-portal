# Trust Portal environment. Copy to .env for local use.
# The full reference (defaults, what each value does, and which values may
# come from the Secrets Manager secret instead) is README.md -> "Configuration reference".

# production (default) | development
PORTAL_ENV=development

# Flask session signing key: at least 32 random characters (required in production).
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Database: a full URL...
DATABASE_URL=postgresql://trust_portal:password@localhost:5433/trust_portal
# ...or its parts (the password may come from the portal secret):
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSLMODE=require
# Migration-owner role (required in production; environment only, never the secret).
# Migrations run as the owner, the app role above is provisioned automatically, and the
# entrypoint removes these before the web server starts:
# DATABASE_OWNER_USER=
# DATABASE_OWNER_PASSWORD=
# DATABASE_OWNER_URL=

# PostgreSQL container settings (docker-compose.yml)
POSTGRES_DB=trust_portal
POSTGRES_USER=trust_portal
POSTGRES_PASSWORD=

# AWS: base credentials whose only permission is sts:AssumeRole on the runtime role,
# the runtime role, and the secret holding everything else.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_RUNTIME_ROLE_ARN=
# AWS_RUNTIME_ROLE_EXTERNAL_ID=
# PORTAL_SECRET_ID=

# Admin bootstrap through /setup while no active admin holds an API key (>= 32 chars in production).
# BOOTSTRAP_TOKEN=

# Fernet key(s) for credentials stored in the database (collectors, git sources), primary first.
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# COLLECTOR_ENCRYPTION_KEYS=

# Token for GitHub git sources using credential mode "portal_secret".
# GITHUB_TOKEN=

# Ship application and access logs to this existing CloudWatch Logs group.
# CLOUDWATCH_LOG_GROUP=

# S3 bucket with Object Lock that receives the audit chain head under chain-heads/.
# AUDIT_WITNESS_BUCKET=
# true = never publish chain heads (throwaway databases); environment only, never the secret.
# AUDIT_WITNESS_DISABLED=false

# Directories local-directory git sources may read (':'-separated). Required in production
# for the local provider; the dev compose file sets /data.
# LOCAL_SOURCE_ROOTS=

# LOG_LEVEL=INFO
# TRUSTED_PROXY_HOPS=1
# WEB_CONCURRENCY=2

# Branding defaults until an admin sets them in Admin > Settings.
PORTAL_COMPANY_NAME=Your Company
PORTAL_BRAND_NAME=Your Brand
PORTAL_CONTACT_EMAIL=compliance@example.com

# Host port for docker-compose.yml
PORT=5100

# Workstation settings for the decision-log SessionEnd hook (scripts/session-end-hook.sh).
TRUST_PORTAL_API_URL=https://trust.example.com
TRUST_PORTAL_API_KEY=
